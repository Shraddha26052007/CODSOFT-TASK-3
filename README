#include <iostream>
using namespace std;

char board[3][3];

// Initialize board
void initBoard() {
    for (int i = 0; i < 3; i++)
        for (int j = 0; j < 3; j++)
            board[i][j] = ' ';
}

// Display board
void printBoard() {
    cout << "\nBoard:\n";
    for (int i = 0; i < 3; i++) {
        cout << " " << board[i][0] << " | " << board[i][1] << " | " << board[i][2] << "\n";
        if (i < 2) cout << "---+---+---\n";
    }
    cout << endl;
}

// Check valid move
bool isValidMove(int r, int c) {
    return r >= 0 && r < 3 && c >= 0 && c < 3 && board[r][c] == ' ';
}

// Check win
bool checkWin(char p) {
    for (int i = 0; i < 3; i++) {
        if (board[i][0] == p && board[i][1] == p && board[i][2] == p) return true;
        if (board[0][i] == p && board[1][i] == p && board[2][i] == p) return true;
    }

    if (board[0][0] == p && board[1][1] == p && board[2][2] == p) return true;
    if (board[0][2] == p && board[1][1] == p && board[2][0] == p) return true;

    return false;
}

// Check draw
bool isDraw() {
    for (int i = 0; i < 3; i++)
        for (int j = 0; j < 3; j++)
            if (board[i][j] == ' ')
                return false;
    return true;
}

int main() {
    char currentPlayer;
    char again = 'y';

   while (again == 'y' || again == 'Y') {
        initBoard();
        currentPlayer = 'X';
        bool gameOver = false;
    while (!gameOver) {
            printBoard();
            cout << "Player " << currentPlayer << " enter row and column (1-3): ";
      int row, col;
            cin >> row >> col;
            row--; 
            col--;
     if (isValidMove(row, col)) {
                board[row][col] = currentPlayer;
        if (checkWin(currentPlayer)) {
                    printBoard();
                    cout << "Player " << currentPlayer << " wins!\n";
                    gameOver = true;
                }
                else if (isDraw()) {
                    printBoard();
                    cout << "It's a draw!\n";
                    gameOver = true;
                }
                else {
                    currentPlayer = (currentPlayer == 'X') ? 'O' : 'X';
                }
            } else {
                cout << "Invalid move. Try again.\n";
            }
        }

  cout << "Play again? (y/n): ";
        cin >> again;
    }
  return 0;
}
